PORT=5000
# the address of the React site. When hosting, add the Netlify link after a comma:
# CLIENT_URL=http://localhost:5173,https://your-site.netlify.app
CLIENT_URL=http://localhost:5173

# Secret used to sign login tokens (JWT). Use a long random string, e.g. run:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=2h

# Firebase service account key (Firebase console > Project settings >
# Service accounts > Generate new private key). Save the file in this folder.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# When hosting online, use this instead of the file (see README, Deploy section):
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Mailjet email API (https://www.mailjet.com)
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
# must be an email address you have verified as a sender in Mailjet
EMAIL_FROM=your-verified-email@gmail.com
